<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" styleClass="view-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacionapp.controller.ProductoController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <!-- SECCIÓN IZQUIERDA: Formulario -->
        <VBox prefWidth="320.0" spacing="12.0" styleClass="card-panel">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="section-title" text="Gestión de Producto" />

                <VBox spacing="3.0">
                    <children>
                        <Label text="Código:" />
                        <TextField fx:id="txtCodigo" promptText="Ingrese el código" />
                    </children>
                </VBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Nombre:" />
                        <TextField fx:id="txtNombre" promptText="Nombre del producto" />
                    </children>
                </VBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Categoría:" />
                        <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccionar..." />
                    </children>
                </VBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Precio:" />
                        <TextField fx:id="txtPrecio" promptText="0.00" />
                    </children>
                </VBox>

                <VBox spacing="3.0">
                    <children>
                        <Label text="Existencia:" />
                        <TextField fx:id="txtExistencia" promptText="0" />
                    </children>
                </VBox>

                <!-- Vista y Selección de Imagen -->
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <ImageView fx:id="imgProducto" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                        <Button fx:id="btnImagen" mnemonicParsing="false" onAction="#seleccionarImagen" styleClass="btn-secondary" text="Buscar Imagen" />
                    </children>
                </VBox>

                <CheckBox fx:id="chkActivo" mnemonicParsing="false" text="Estado Activo" />

                <!-- Botones CRUD -->
                <VBox spacing="8.0">
                    <children>
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button fx:id="btnGuardar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primary" text="Guardar" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnActualizar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secondary" text="Actualizar" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER" spacing="8.0">
                            <children>
                                <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-secondary" text="Eliminar" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnLimpiar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-secondary" text="Limpiar" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets top="5.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>

        <!-- SECCIÓN DERECHA: Tabla, Búsqueda y Filtros -->
        <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="section-title" text="Catálogo de Productos" />

                <!-- BARRA DE BÚSQUEDA Y FILTROS -->
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <children>
                        <TextField fx:id="txtBuscar" promptText="Buscar por código, nombre o cat..." HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbFiltroEstado" prefWidth="130.0" promptText="Estado" />
                        <ComboBox fx:id="cmbFiltroCategoria" prefWidth="150.0" promptText="Categoría" />
                    </children>
                </HBox>

                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="180.0" text="Nombre" />
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" text="Categoría" />
                        <TableColumn fx:id="colPrecio" prefWidth="90.0" text="Precio" />
                        <TableColumn fx:id="colExistencia" prefWidth="90.0" text="Existencia" />
                        <TableColumn fx:id="colActivo" prefWidth="80.0" text="Estado" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>