<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="20.0" styleClass="view-container" stylesheets="@../styles/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.facturacionapp.controller.CategoriaController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <children>
        <!-- COLUMNA IZQUIERDA: FORMULARIO EN TARJETA -->
        <VBox prefWidth="320.0" spacing="12.0" styleClass="card-panel">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="section-title" text="Gestión de Categoría" />

                <VBox spacing="4.0">
                    <children>
                        <Label text="Nombre:" />
                        <TextField fx:id="txtNombre" promptText="Ej: Bebidas, Lácteos..." />
                    </children>
                </VBox>

                <CheckBox fx:id="chkActivo" mnemonicParsing="false" selected="true" text="Estado Activo" />

                <!-- Acciones del Formulario -->
                <VBox spacing="8.0">
                    <children>
                        <HBox spacing="8.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" styleClass="btn-primary" text="Guardar" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" styleClass="btn-secondary" text="Actualizar" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <HBox spacing="8.0">
                            <children>
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiar" styleClass="btn-secondary" text="Limpiar" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminar" styleClass="btn-danger" text="Eliminar" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </VBox>
            </children>
        </VBox>

        <!-- COLUMNA DERECHA: TABLA EXPANDIDA -->
        <VBox spacing="10.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <Label styleClass="section-title" text="Catálogo de Categorías Registradas" />

                <TableView fx:id="tblCategorias" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="250.0" text="Nombre de Categoría" />
                        <TableColumn fx:id="colActivo" prefWidth="100.0" text="Estado" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>